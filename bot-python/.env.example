# ── Telegram ──────────────────────────────────────────────────
# Token del bot (BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Chat id del ÚNICO usuario autorizado (el vendedor). Obtenlo con @userinfobot
AUTHORIZED_CHAT_ID=1036420688

# ── MercadoLibre ──────────────────────────────────────────────
# Id del vendedor (user_id de ML)
ML_SELLER_ID=283388639
# Site: Chile = MLC
ML_SITE_ID=MLC

# OPCIÓN A (directo a la API de ML): pega el access token y déjalo así.
#   Caduca cada ~6h: tendrás que renovarlo. El bot avisa cuando expira (401).
ML_ACCESS_TOKEN=APP_USR-...
ML_BASE_URL=https://api.mercadolibre.com
ML_USE_PROXY=false

# OPCIÓN B (recomendada): usa el Worker proxy MLPU que renueva el token solo.
#   Deja ML_ACCESS_TOKEN vacío y descomenta:
# ML_BASE_URL=https://mlpu-proxy.aronricocl.workers.dev/ml
# ML_USE_PROXY=true

# ── Modo de ejecución ─────────────────────────────────────────
# Si defines WEBHOOK_URL corre en modo webhook; si lo dejas vacío, polling.
WEBHOOK_URL=
WEBHOOK_PORT=8443
WEBHOOK_LISTEN=0.0.0.0
# Secret token opcional para validar que el webhook viene de Telegram
WEBHOOK_SECRET=

# Cada cuántos segundos el bot consulta ML por ventas/mensajes nuevos
POLL_INTERVAL=60

# ── Avanzado (opcional) ───────────────────────────────────────
ML_TIMEOUT=10
ML_MAX_RETRIES=2
LOG_LEVEL=INFO
LOG_DIR=logs
PERSISTENCE_FILE=bot_state.pickle
